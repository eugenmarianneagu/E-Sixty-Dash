<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fundal semitransparent pe prima treime de jos a cercului -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#A60A0B0F"
                android:centerColor="#BF08090C"
                android:endColor="#D9050608" />
        </shape>
    </item>
    <!-- Linie fina de accent BMW Amber la marginea de sus a barii -->
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#55FF7200" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
