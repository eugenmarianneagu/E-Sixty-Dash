<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/call_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8000000"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/call_overlay_card"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_call_panel"
        android:padding="24dp">

        <!-- Titlu status apel -->
        <TextView
            android:id="@+id/overlay_call_status_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ APEL DE INTRARE"
            android:textColor="@color/bmw_amber"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/overlay_call_duration_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/bmw_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Zona Poza Contact + Nume & Numar -->
        <FrameLayout
            android:id="@+id/overlay_call_photo_frame"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_photo"
            android:foreground="@drawable/bg_circle_photo_border"
            android:padding="2dp"
            app:layout_constraintTop_toBottomOf="@id/overlay_call_status_title"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/overlay_call_contact_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_call_avatar" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="@id/overlay_call_photo_frame"
            app:layout_constraintBottom_toBottomOf="@id/overlay_call_photo_frame"
            app:layout_constraintStart_toEndOf="@id/overlay_call_photo_frame"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/overlay_call_contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Număr Necunoscut"
                android:textColor="@color/bmw_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever" />

            <TextView
                android:id="@+id/overlay_call_phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/bmw_amber"
                android:textSize="15sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Butoane apel de intrare: DENY & ANSWER -->
        <LinearLayout
            android:id="@+id/overlay_call_ringing_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/overlay_call_photo_frame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Buton Respinge (DENY) -->
            <LinearLayout
                android:id="@+id/overlay_btn_call_deny"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_call_btn_deny"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_call_end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="RESPINGE"
                    android:textColor="@color/bmw_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Buton Raspunde (ANSWER) -->
            <LinearLayout
                android:id="@+id/overlay_btn_call_answer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_call_btn_answer"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_call_answer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="RĂSPUNDE"
                    android:textColor="@color/bmw_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buton Încheiere Apel (HANG UP - când apelul e activ sau în curs de apelare) -->
        <LinearLayout
            android:id="@+id/overlay_btn_call_hangup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_call_btn_deny"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@id/overlay_call_photo_frame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="ÎNCHEIE APELUL"
                android:textColor="@color/bmw_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
